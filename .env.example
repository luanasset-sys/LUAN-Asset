# ─────────────────────────────────────────────────────────────────────────────
# Equity Research HQ — environment template
# Copy to `.env` and fill in. `.env` is gitignored; never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# 1) SEC EDGAR — no API key. EDGAR REQUIRES a descriptive User-Agent with a real
#    contact email, or it will throttle/deny you. Format: "Name email".
SEC_USER_AGENT=Karim Vakili kvakili@wharton.upenn.edu

# 2) yfinance — no key needed.

# 3) FRED (Federal Reserve Economic Data) — free key.
#    Get one: https://fredaccount.stlouisfed.org/  ->  My Account  ->  API Keys
FRED_API_KEY=b0f1094ecfe3093dbb202391ec6977f5

# 4) Anthropic — powers the Macro lens (live web search w/ citations) and the
#    optional narrative polish on verdicts.
#    Get one: https://console.anthropic.com/  ->  API keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# 5) Airtable — Personal Access Token (PAT). The standalone script writes
#    directly to Airtable at runtime (the in-session MCP is not available here).
#    Token needs scopes: data.records:read, data.records:write,
#    schema.bases:read, schema.bases:write  — and access to the base below.
#    Create: https://airtable.com/create/tokens
AIRTABLE_API_KEY=
# Base "Equity Research HQ" (already created in your workspace):
AIRTABLE_BASE_ID=appL5ByzBTesKLEWo

# 6) Google Sheets mirror (optional — run with --no-sheets to skip).
#    Path to the service-account JSON key file, and the target Sheet's ID.
#    See README.md "Google Sheets setup" for click-by-click steps.
GOOGLE_SA_JSON=./service_account.json
GOOGLE_SHEET_ID=
